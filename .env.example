# Phase 2 Binance market-data recorder
SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_MARKET=usdm_futures
STREAMS=aggTrade,trade,depth@100ms,bookTicker
PUBLISHER=jsonl
JSONL_PATH=data/raw/binance_market_data.jsonl
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=market-data-recorder
RECONNECT_INITIAL_DELAY_S=1.0
RECONNECT_MAX_DELAY_S=30.0
RECONNECT_JITTER_S=0.25
WEBSOCKET_READ_TIMEOUT_S=30.0
MAX_QUEUE_SIZE=100000
ENABLE_RAW_PAYLOAD=true

# Phase 4 storage
STORAGE_SINK=clickhouse
STORAGE_MAX_BATCH_ROWS=5000
STORAGE_MAX_LINGER_MS=250
STORAGE_MAX_QUEUE_SIZE=250000
STORAGE_DEAD_LETTER_PATH=data/dead_letter/storage_failures.jsonl
STORAGE_FAIL_FAST=false
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=tradingbot
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_S=10
CLICKHOUSE_COMPRESSION=true
POSTGRES_DSN=postgresql://tradingbot:tradingbot@localhost:5432/tradingbot
POSTGRES_MIN_POOL_SIZE=1
POSTGRES_MAX_POOL_SIZE=5
POSTGRES_COMMAND_TIMEOUT_S=10

# Phase 13 monitoring
MONITORING_HOST=0.0.0.0
MONITORING_PORT=8080
MONITORING_COMPONENTS=monitoring_api,market_data,order_book,features,liquidity,sweep,avwap,signals,risk,paper_execution
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_URL=http://localhost:9093

# Phase 14 Binance live execution adapter
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_ENABLE_LIVE_TRADING=false
BINANCE_RECV_WINDOW_MS=5000
BINANCE_REQUEST_TIMEOUT_S=5
BINANCE_MAX_RETRIES=2
BINANCE_RETRY_BACKOFF_S=0.25
BINANCE_ONE_WAY_MODE=true
BINANCE_CLIENT_ORDER_PREFIX=tb14

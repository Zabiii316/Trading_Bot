{
  "$defs": {
    "MarketType": {
      "enum": [
        "spot",
        "perpetual_futures",
        "delivery_futures",
        "forex",
        "paper"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "RiskDecisionStatus": {
      "enum": [
        "approved",
        "rejected",
        "reduced_size",
        "halted"
      ],
      "title": "RiskDecisionStatus",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "binance_spot",
        "binance_usdm",
        "binance_coinm",
        "tradingview",
        "paper",
        "internal"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_equity_quote": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Account Equity Quote"
    },
    "approved_quantity": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Approved Quantity"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "event_type": {
      "const": "risk.decision",
      "default": "risk.decision",
      "title": "Event Type",
      "type": "string"
    },
    "market_type": {
      "$ref": "#/$defs/MarketType"
    },
    "max_loss_quote": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Max Loss Quote"
    },
    "received_time_ms": {
      "minimum": 0,
      "title": "Received Time Ms",
      "type": "integer"
    },
    "rejection_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "array"
    },
    "risk_fraction": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Risk Fraction"
    },
    "risk_snapshot_id": {
      "format": "uuid",
      "title": "Risk Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_id": {
      "format": "uuid",
      "title": "Signal Id",
      "type": "string"
    },
    "source": {
      "description": "Service or connector that emitted event",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RiskDecisionStatus"
    },
    "symbol": {
      "examples": [
        "BTCUSDT"
      ],
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    }
  },
  "required": [
    "source",
    "venue",
    "market_type",
    "symbol",
    "event_time_ms",
    "received_time_ms",
    "signal_id",
    "status",
    "account_equity_quote",
    "risk_fraction"
  ],
  "title": "RiskDecisionEvent",
  "type": "object"
}
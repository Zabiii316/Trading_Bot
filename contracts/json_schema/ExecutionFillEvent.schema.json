{
  "$defs": {
    "MarketType": {
      "enum": [
        "spot",
        "perpetual_futures",
        "delivery_futures",
        "forex",
        "paper"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "OrderSide": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "binance_spot",
        "binance_usdm",
        "binance_coinm",
        "tradingview",
        "paper",
        "internal"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_order_id": {
      "title": "Client Order Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "event_type": {
      "const": "execution.fill",
      "default": "execution.fill",
      "title": "Event Type",
      "type": "string"
    },
    "fee_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Fee Amount"
    },
    "fee_asset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fee Asset"
    },
    "fill_id": {
      "format": "uuid",
      "title": "Fill Id",
      "type": "string"
    },
    "fill_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Fill Price"
    },
    "fill_quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Fill Quantity"
    },
    "is_maker": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Maker"
    },
    "liquidity_tag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Liquidity Tag"
    },
    "market_type": {
      "$ref": "#/$defs/MarketType"
    },
    "order_id": {
      "format": "uuid",
      "title": "Order Id",
      "type": "string"
    },
    "received_time_ms": {
      "minimum": 0,
      "title": "Received Time Ms",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/OrderSide"
    },
    "source": {
      "description": "Service or connector that emitted event",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "symbol": {
      "examples": [
        "BTCUSDT"
      ],
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    },
    "venue_order_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue Order Id"
    }
  },
  "required": [
    "source",
    "venue",
    "market_type",
    "symbol",
    "event_time_ms",
    "received_time_ms",
    "order_id",
    "client_order_id",
    "side",
    "fill_price",
    "fill_quantity"
  ],
  "title": "ExecutionFillEvent",
  "type": "object"
}
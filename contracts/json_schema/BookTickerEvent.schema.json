{
  "$defs": {
    "MarketType": {
      "enum": [
        "spot",
        "perpetual_futures",
        "delivery_futures",
        "forex",
        "paper"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "binance_spot",
        "binance_usdm",
        "binance_coinm",
        "tradingview",
        "paper",
        "internal"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "best_ask_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Best Ask Price"
    },
    "best_ask_quantity": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Best Ask Quantity"
    },
    "best_bid_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Best Bid Price"
    },
    "best_bid_quantity": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Best Bid Quantity"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "event_type": {
      "const": "raw.book_ticker",
      "default": "raw.book_ticker",
      "title": "Event Type",
      "type": "string"
    },
    "market_type": {
      "$ref": "#/$defs/MarketType"
    },
    "received_time_ms": {
      "minimum": 0,
      "title": "Received Time Ms",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Service or connector that emitted event",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "symbol": {
      "examples": [
        "BTCUSDT"
      ],
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Update Id"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    }
  },
  "required": [
    "source",
    "venue",
    "market_type",
    "symbol",
    "event_time_ms",
    "received_time_ms",
    "best_bid_price",
    "best_bid_quantity",
    "best_ask_price",
    "best_ask_quantity"
  ],
  "title": "BookTickerEvent",
  "type": "object"
}
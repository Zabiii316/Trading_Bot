{
  "$defs": {
    "LiquidityLevelType": {
      "enum": [
        "previous_day_high",
        "previous_day_low",
        "previous_week_high",
        "previous_week_low",
        "session_high",
        "session_low",
        "swing_high",
        "swing_low",
        "equal_highs",
        "equal_lows",
        "round_number",
        "custom"
      ],
      "title": "LiquidityLevelType",
      "type": "string"
    },
    "MarketType": {
      "enum": [
        "spot",
        "perpetual_futures",
        "delivery_futures",
        "forex",
        "paper"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "binance_spot",
        "binance_usdm",
        "binance_coinm",
        "tradingview",
        "paper",
        "internal"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "event_type": {
      "const": "liquidity.level",
      "default": "liquidity.level",
      "title": "Event Type",
      "type": "string"
    },
    "first_seen_ms": {
      "minimum": 0,
      "title": "First Seen Ms",
      "type": "integer"
    },
    "is_active": {
      "default": true,
      "title": "Is Active",
      "type": "boolean"
    },
    "last_seen_ms": {
      "minimum": 0,
      "title": "Last Seen Ms",
      "type": "integer"
    },
    "level_id": {
      "format": "uuid",
      "title": "Level Id",
      "type": "string"
    },
    "level_type": {
      "$ref": "#/$defs/LiquidityLevelType"
    },
    "market_type": {
      "$ref": "#/$defs/MarketType"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Price"
    },
    "quality_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quality Score"
    },
    "received_time_ms": {
      "minimum": 0,
      "title": "Received Time Ms",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Service or connector that emitted event",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "symbol": {
      "examples": [
        "BTCUSDT"
      ],
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "touches": {
      "minimum": 0,
      "title": "Touches",
      "type": "integer"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    },
    "zone_high": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Zone High"
    },
    "zone_low": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Zone Low"
    }
  },
  "required": [
    "source",
    "venue",
    "market_type",
    "symbol",
    "event_time_ms",
    "received_time_ms",
    "level_type",
    "price",
    "zone_low",
    "zone_high",
    "quality_score",
    "touches",
    "first_seen_ms",
    "last_seen_ms"
  ],
  "title": "LiquidityLevelEvent",
  "type": "object"
}
{
  "$defs": {
    "AggressorSide": {
      "enum": [
        "buy",
        "sell",
        "unknown"
      ],
      "title": "AggressorSide",
      "type": "string"
    },
    "MarketType": {
      "enum": [
        "spot",
        "perpetual_futures",
        "delivery_futures",
        "forex",
        "paper"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "binance_spot",
        "binance_usdm",
        "binance_coinm",
        "tradingview",
        "paper",
        "internal"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggressor_side": {
      "$ref": "#/$defs/AggressorSide"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_time_ms": {
      "minimum": 0,
      "title": "Event Time Ms",
      "type": "integer"
    },
    "event_type": {
      "const": "raw.trade",
      "default": "raw.trade",
      "title": "Event Type",
      "type": "string"
    },
    "is_buyer_maker": {
      "title": "Is Buyer Maker",
      "type": "boolean"
    },
    "market_type": {
      "$ref": "#/$defs/MarketType"
    },
    "price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Price"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quantity"
    },
    "raw": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw"
    },
    "received_time_ms": {
      "minimum": 0,
      "title": "Received Time Ms",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "description": "Service or connector that emitted event",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "symbol": {
      "examples": [
        "BTCUSDT"
      ],
      "minLength": 3,
      "title": "Symbol",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "trade_id": {
      "minimum": 0,
      "title": "Trade Id",
      "type": "integer"
    },
    "trade_time_ms": {
      "minimum": 0,
      "title": "Trade Time Ms",
      "type": "integer"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    }
  },
  "required": [
    "source",
    "venue",
    "market_type",
    "symbol",
    "event_time_ms",
    "received_time_ms",
    "trade_id",
    "price",
    "quantity",
    "trade_time_ms",
    "is_buyer_maker",
    "aggressor_side"
  ],
  "title": "RawTradeEvent",
  "type": "object"
}